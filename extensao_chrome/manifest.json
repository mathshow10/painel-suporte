{
  "manifest_version": 3,
  "name": "Painel de Suporte — menu do botão direito",
  "version": "1.3",
  "description": "Coloca as funções do Painel de Suporte no menu do botão direito e lê/cola no ticket sem teclas simuladas.",
  "permissions": ["contextMenus", "scripting", "activeTab", "offscreen", "alarms"],
  "host_permissions": ["http://127.0.0.1:47391/*", "https://tickets.exemplo.com/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icone16.png", "32": "icone32.png", "48": "icone48.png", "128": "icone128.png" },
  "action": {
    "default_title": "Painel de Suporte",
    "default_icon": { "16": "icone16.png", "32": "icone32.png" }
  }
}
